{
  "name": "studydock",
  "version": "1.0.0",
  "private": true,
  "description": "Local-first learning dashboard and progress tracker backed by PostgreSQL",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:ui-eval": "tsx scripts/evaluate-ui.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "npx tsx ./src/db/migrate.ts",
    "db:seed": "npx tsx ./scripts/seed.ts",
    "db:push": "drizzle-kit push",
    "db:backup": "bash scripts/db-backup.sh",
    "db:restore": "bash scripts/db-restore.sh",
    "fallow": "fallow",
    "audit": "fallow audit"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "csv-parse": "^5.6.0",
    "csv-stringify": "^6.9.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.39.0",
    "lucide-react": "^0.475.0",
    "next": "14.2.25",
    "postgres": "^3.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.30.4",
    "fallow": "^3.33.1",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
